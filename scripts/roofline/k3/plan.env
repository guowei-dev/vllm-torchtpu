# shellcheck shell=bash disable=SC2034
# The capture plan of a k3-roofline slot (sourced by capture.sh). A different plan is a different commit.

# The AgentX profiling phase has to be running this long before the first window.
K3CAP_MIN_DELAY_S=180
# Windows: accepted ones wanted, attempts allowed, the gap between the end of one and the start of the next.
K3CAP_WANT=2
K3CAP_ATTEMPTS=5
K3CAP_SPACING_S=300
# Window length (s): the low-concurrency points idle most of the time (golden decode running p50 <= 4), so a longer
# window holds as many steps.
K3CAP_WINDOW_S=6
K3CAP_WINDOW_S_LOWCONC=15
K3CAP_LOWCONC_MAX=16
# A -scopes slot traces every phase of every layer: a short window keeps the device trace buffers from dropping.
K3CAP_WINDOW_S_SCOPES=3
# The gate waits this long (polling every K3CAP_GATE_POLL_S) for the decode gauge to enter the band, then captures
# anyway and records the window as out of band.
K3CAP_GATE_WAIT_S=900
K3CAP_GATE_POLL_S=2
# Extra prefill-gated windows when no accepted window held a prefill forward (the prefill idles at low concurrency).
K3CAP_PREFILL_ATTEMPTS=3
# In-pod trace acceptance: decoder steps on decode rank 0, prefill forwards on prefill rank 0.
K3CAP_MIN_DECODE_STEPS=20
K3CAP_MIN_PREFILL_FORWARDS=1
# Waits: the profiling phase (server boot + readiness + warmup), each window's uploads.
K3CAP_PHASE_WAIT_S=10800
K3CAP_UPLOAD_WAIT_S=1500
K3CAP_POLL_S=10
